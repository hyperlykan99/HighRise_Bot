# ChillTopia DJ Dashboard — environment variables
# Copy this file to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────

# Port the dashboard HTTP server listens on (default: 3000)
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────

# Absolute path to the bot's SQLite database file.
# The bot writes it to: artifacts/highrise-bot/highrise_hangout.db
# On your VPS, either:
#   - copy the DB file here and keep it in sync (cron rsync), or
#   - mount the bot's DB directory as a shared volume.
DB_PATH=/home/chilltopia/highrise_hangout.db

# ── Radio / AzuraCast ─────────────────────────────────────────────────────────

# Public AzuraCast audio stream URL shown to dashboard visitors.
# This is the stream URL only — safe to expose in the browser.
# When set, this overrides whatever radio_url is stored in the bot's DB.
# Leave blank to use the URL configured via the bot's !setradio command.
AZURACAST_STREAM_URL=https://radio.example.com/listen/chilltopia/radio.mp3

# DO NOT add AZURA_API_KEY here — it is used only by the Python bot and
# must never be sent to the browser or stored in this server's config.
