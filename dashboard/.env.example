# ChillTopia DJ Dashboard — environment variables
# Copy this file to .env and fill in your values.
# Only ONE data source is needed: REMOTE_STATUS_URL (recommended while bot
# is on Replit) or DB_PATH (when bot and dashboard share a machine).

# ── Server ────────────────────────────────────────────────────────────────────

# Port the dashboard HTTP server listens on (default: 3000)
PORT=3000

# ── Data source: Mode A — Remote (Replit live data) ──────────────────────────
#
# Point this at your Replit project's public API endpoint.
# The VPS dashboard will proxy all status requests through it.
# No bot runs on the VPS — DJ_DUDU keeps running on Replit only.
#
# How to find your URL:
#   1. Open your Replit project
#   2. Click the "Open in new tab" icon in the preview pane
#   3. Your domain looks like: https://abc123.username.replit.dev
#   4. Append /api/dj/status
#
# Example:
REMOTE_STATUS_URL=https://YOUR-REPL-SLUG.replit.dev/api/dj/status

# Optional: timeout in ms for remote fetch (default: 8000)
# REMOTE_TIMEOUT_MS=8000

# ── Data source: Mode B — Local SQLite (future VPS migration) ─────────────────
#
# Used as a fallback when REMOTE_STATUS_URL is not set.
# Point this at a local copy of the bot's SQLite database file.
# The bot writes it to: artifacts/highrise-bot/highrise_hangout.db
#
# DB_PATH=/home/chilltopia/highrise_hangout.db

# ── Radio / AzuraCast ─────────────────────────────────────────────────────────

# Optional: override the stream URL shown to listeners (audio stream only).
# When set, replaces whatever radio_url comes from Replit or the local DB.
# This is the public stream URL — safe to set here.
#
# AZURACAST_STREAM_URL=https://radio.example.com/listen/chilltopia/radio.mp3

# DO NOT add AZURA_API_KEY or BOT_TOKEN here.
# Those credentials belong only to the bot on Replit and must never be
# exposed in this server's config or sent to the browser.
