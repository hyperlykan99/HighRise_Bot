# ChillTopia Owner/Staff Dashboard

PORT=3000

# Shared SQLite database written by the HighRise bots.
# Must match /opt/highrise-bots/.env SHARED_DB_PATH on VPS.
DB_PATH=/opt/highrise-bots/artifacts/highrise-bot/highrise_hangout.db

# First owner bootstrap. Used only if this username does not already exist.
# Remove DASHBOARD_BOOTSTRAP_PASSWORD after the first successful login.
DASHBOARD_BOOTSTRAP_OWNER=YourOwnerUsername
DASHBOARD_BOOTSTRAP_PASSWORD=change-this-long-random-password

# Session cookie lifetime in days.
DASHBOARD_SESSION_DAYS=7

# Set to 1 when the dashboard is served over HTTPS.
# DASHBOARD_COOKIE_SECURE=1

# Optional remote read-only radio status endpoint. Control actions still require DB_PATH.
# REMOTE_STATUS_URL=https://YOUR-REPL-SLUG.replit.dev/api/dj/status
# REMOTE_TIMEOUT_MS=8000

# Optional public stream URL only. Never set AZURA_API_KEY here.
# AZURACAST_STREAM_URL=https://radio.example.com/listen/chilltopia/radio.mp3

# Do not put BOT_TOKEN, AZURA_API_KEY, or room secrets in dashboard env files.
